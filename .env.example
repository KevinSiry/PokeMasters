# Copie ce fichier en .env (npm run setup le fait pour toi et génère AUTH_SECRET).

# ── Base de données et Redis (valeurs de docker-compose.yml) ──
DATABASE_URL="postgresql://pokeflex:pokeflex@localhost:5432/pokeflex?schema=public"
REDIS_URL="redis://localhost:6379"

# ── Application ──
APP_URL="http://localhost:3000"
REALTIME_PORT=3001
NEXT_PUBLIC_REALTIME_URL="http://localhost:3001"

# ── Auth.js ──
# Secret de chiffrement des sessions. Généré par `npm run setup`.
AUTH_SECRET=""
# Twitch : https://dev.twitch.tv/console/apps  (URL de redirection : http://localhost:3000/api/auth/callback/twitch)
AUTH_TWITCH_ID=""
AUTH_TWITCH_SECRET=""
# Discord : https://discord.com/developers/applications  (Redirect : http://localhost:3000/api/auth/callback/discord)
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# Connexion aux comptes de démo sans OAuth (jamais active en production).
ALLOW_DEV_LOGIN="true"
