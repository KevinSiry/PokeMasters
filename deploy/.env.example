# .env de PokeFlex sur le VPS (~/pokeflex/.env, chmod 600). Guide : docs/deploiement.md
# Ne jamais réutiliser les valeurs du .env de dev.

# Domaine public, sans https:// (doit pointer sur le VPS, et correspondre à la variable
# PUBLIC_URL du dépôt GitHub : l'adresse du temps réel est figée dans l'image au build).
DOMAIN=pokeflex.example.fr

# Base de données. Mot de passe en hexadécimal (il va dans une URL) : openssl rand -hex 24
POSTGRES_USER=pokeflex
POSTGRES_PASSWORD=
POSTGRES_DB=pokeflex

# Sessions Auth.js : openssl rand -base64 32
AUTH_SECRET=

# Connexion Twitch : https://dev.twitch.tv/console/apps
# URL de redirection : https://<DOMAIN>/api/auth/callback/twitch
AUTH_TWITCH_ID=
AUTH_TWITCH_SECRET=

# Connexion Discord (facultative) : https://discord.com/developers/applications
# Redirect : https://<DOMAIN>/api/auth/callback/discord
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# Synchro quotidienne du catalogue TCGdex (nouveaux sets + prix).
CATALOG_AUTO_SYNC=true

# Sauvegardes : jours de rétention (backup.sh).
BACKUP_RETENTION_DAYS=14

# Version déployée : mise à jour par le workflow Release. Revenir en arrière = changer cette ligne.
IMAGE_TAG=latest
