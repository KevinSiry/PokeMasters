// PokeFlex — schéma de données.
// Phase 1 : comptes joueurs et modèles Auth.js. Les autres modèles arrivent phase par phase
// (voir DECISIONS.md et le plan).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  player
  moderator
  admin
}

model User {
  id            String    @id @default(cuid())
  /// Nom public choisi par le joueur (unique, modifiable plus tard). Null tant qu'il n'est pas choisi.
  handle        String?   @unique
  /// Rempli par Auth.js depuis Twitch/Discord.
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(player)

  /// Solde de Jetons. Contrainte SQL `balance >= 0` (voir migration). Toujours modifié avec une ligne de ledger (phase 4).
  balance         Int      @default(0)
  /// Minuteur paresseux des boosters gratuits (voir packages/game/src/booster-timer.ts).
  boosterStock    Int      @default(1)
  boosterAnchorAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts    Account[]
  sessions    Session[]
  copies      CardCopy[]
  openings    BoosterOpening[]
  ledger      LedgerEntry[]
  completions SetCompletion[]
  quests      DailyQuest[]
}

// ───────── Modèles standard Auth.js (adaptateur Prisma) ─────────

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ───────── Catalogue (phase 2) ─────────
// Importé depuis TCGdex par `npm run sync:catalog`, jamais appelé à chaque requête joueur.

enum Tier {
  common
  uncommon
  rare
  epic
  legendary
  mythic
}

enum Lang {
  fr
  en
}

enum CardCategory {
  pokemon
  trainer
  energy
}

model Serie {
  id               String    @id
  name             String
  logo             String?
  lang             Lang      @default(fr)
  /// Date de sortie du premier set, pour ordonner les séries.
  firstReleaseDate DateTime?
  syncedAt         DateTime  @default(now())
  sets             Set[]
}

model Set {
  id                String          @id
  serieId           String
  serie             Serie           @relation(fields: [serieId], references: [id])
  name              String
  nameEn            String?
  logo              String?
  symbol            String?
  releaseDate       DateTime?
  cardCountOfficial Int
  cardCountTotal    Int
  lang              Lang            @default(fr)
  syncedAt          DateTime        @default(now())
  cards             Card[]
  completions       SetCompletion[]

  @@index([serieId, releaseDate])
  @@index([releaseDate])
}

model Card {
  id             String       @id
  localId        String
  /// Ordre naturel dans le set (numéro de carte quand il est numérique).
  sortKey        Int          @default(0)
  setId          String
  set            Set          @relation(fields: [setId], references: [id])
  nameFr         String?
  nameEn         String?
  /// Nom affiché (FR si disponible, sinon EN).
  name           String
  /// Langue des données affichées (badge « EN » quand la version française n'existe pas).
  lang           Lang
  /// URL de base sur le CDN TCGdex (on ajoute /low.webp ou /high.webp) ; null → visuel de remplacement.
  image          String?
  imageLang      Lang?
  category       CardCategory
  rarityRaw      String?
  tier           Tier
  /// "rarity" | "price_bump" | "fallback" (rareté inconnue du tableau de correspondance).
  tierReason     String
  hp             Int?
  /// Codes canoniques : fire, water, grass…
  types          String[]
  typesRaw       String[]
  stage          String?
  evolveFrom     String?
  dexIds         Int[]
  illustrator    String?
  retreat        Int?
  description    String?
  /// Texte d'effet des cartes Dresseur et Énergie.
  effect         String?
  trainerType    String?
  energyType     String?
  regulationMark String?
  /// [{ name, cost[], damage, effect }]
  attacks        Json         @default("[]")
  abilities      Json         @default("[]")
  /// [{ type, value }] avec type canonique.
  weaknesses     Json         @default("[]")
  resistances    Json         @default("[]")
  /// { normal, reverse, holo, firstEdition }
  variants       Json         @default("{}")
  priceEurTrend  Decimal?     @db.Decimal(10, 2)
  priceUpdatedAt DateTime?
  /// Exclure du tirage (carte sans image, etc.).
  droppable      Boolean      @default(true)
  syncedAt       DateTime     @default(now())
  copies         CardCopy[]

  @@index([setId, sortKey])
  @@index([tier, droppable])
  @@index([illustrator])
  @@index([category])
}

/// Historique des synchronisations (reprise sur erreur, journal).
model SyncRun {
  id         String    @id @default(cuid())
  kind       String
  startedAt  DateTime  @default(now())
  /// Battement de cœur : une synchro en cours le met à jour après chaque set.
  updatedAt  DateTime  @updatedAt
  finishedAt DateTime?
  /// { doneSets: string[] } : sets entièrement traités, sautés à la reprise.
  cursor     Json?
  stats      Json?
  error      String?

  @@index([kind, startedAt])
}

// ───────── Collection (phase 3) ─────────

enum Finish {
  normal
  reverse
  holo
  firstEdition
}

enum CopyStatus {
  owned
  listed
  staked
}

/// Un exemplaire possédé = une ligne. Un exemplaire listé au marché ou misé en duel change de statut.
model CardCopy {
  id          String     @id @default(cuid())
  ownerId     String
  owner       User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  cardId      String
  card        Card       @relation(fields: [cardId], references: [id])
  finish      Finish     @default(normal)
  status      CopyStatus @default(owned)
  /// booster | set_booster | market | duel | seed
  obtainedVia String
  openingId   String?
  obtainedAt  DateTime   @default(now())

  @@index([ownerId, cardId])
  @@index([ownerId, obtainedAt])
  @@index([cardId])
}

/// Audit de chaque ouverture : le tirage est figé côté serveur avant toute animation.
model BoosterOpening {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// all_eras | set
  kind      String
  setId     String?
  cardIds   String[]
  tiers     Tier[]
  finishes  Finish[]
  cost      Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ───────── Économie [P4] ─────────

enum LedgerReason {
  seed
  admin
  recycle
  set_booster
  set_bonus
  quest
  duel_win
  duel_draw
  duel_loss
  market_fee
  market_sale
  market_purchase
  bid_hold
  bid_release
  guild_create
}

/// Source de vérité des Jetons, en ajout seul. Chaque modification de `User.balance` écrit une ligne
/// dans la même transaction : SUM(delta) = balance (vérifié par `npm run audit:ledger`).
model LedgerEntry {
  id           BigInt       @id @default(autoincrement())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta        Int
  balanceAfter Int
  reason       LedgerReason
  /// Objet lié : "set", "quest", "opening", "listing"…
  refType      String?
  refId        String?
  /// Détails affichés dans l'historique (nombre de cartes recyclées par tier…).
  meta         Json?
  createdAt    DateTime     @default(now())

  @@index([userId, createdAt])
}

/// Set complété par un joueur : le bonus n'est versé qu'une fois, même si des cartes sont recyclées ensuite.
model SetCompletion {
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  setId       String
  set         Set      @relation(fields: [setId], references: [id])
  bonus       Int
  completedAt DateTime @default(now())

  @@id([userId, setId])
}

/// Quêtes du jour, créées à la première visite de la journée (fuseau de `config.quests.timeZone`).
model DailyQuest {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  day       DateTime  @db.Date
  kind      String
  target    Int
  reward    Int
  progress  Int       @default(0)
  claimedAt DateTime?

  @@unique([userId, day, kind])
}
