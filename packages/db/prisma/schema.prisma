// PokeFlex — schéma de données.
// Phase 1 : comptes joueurs et modèles Auth.js. Les autres modèles arrivent phase par phase
// (voir DECISIONS.md et le plan).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  player
  moderator
  admin
}

model User {
  id            String    @id @default(cuid())
  /// Nom public choisi par le joueur (unique, modifiable plus tard). Null tant qu'il n'est pas choisi.
  handle        String?   @unique
  /// Rempli par Auth.js depuis Twitch/Discord.
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(player)
  /// Présentation courte affichée sur le profil public.
  bio           String?
  /// Vitrine du profil : cartes choisies parmi celles possédées (ordre d'affichage).
  showcase      String[]  @default([])

  /// Solde de Jetons. Contrainte SQL `balance >= 0` (voir migration). Toujours modifié avec une ligne de ledger (phase 4).
  balance         Int      @default(0)
  /// Minuteur paresseux des boosters gratuits (voir packages/game/src/booster-timer.ts).
  boosterStock    Int      @default(1)
  boosterAnchorAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts    Account[]
  sessions    Session[]
  copies      CardCopy[]
  openings    BoosterOpening[]
  ledger      LedgerEntry[]
  completions SetCompletion[]
  quests      DailyQuest[]
  listings    Listing[]        @relation("seller")
  bids        Bid[]
  purchases   Sale[]           @relation("buyer")
  sales       Sale[]           @relation("seller")
  friendsOut  Friendship[]     @relation("friendFrom")
  friendsIn   Friendship[]     @relation("friendTo")
  blocks      Block[]          @relation("blocker")
  blockedBy   Block[]          @relation("blocked")
  reports     Report[]         @relation("reporter")
  reported    Report[]         @relation("reportedUser")
  guildMember GuildMember?
  guildsOwned Guild[]
  guildMessages GuildMessage[]
  sentMessages     DirectMessage[] @relation("dmSender")
  receivedMessages DirectMessage[] @relation("dmRecipient")
  favorites   FavoriteCard[]
  wishlist    WishlistCard[]
  tradesOut   Trade[]          @relation("tradeProposer")
  tradesIn    Trade[]          @relation("tradeRecipient")
}

// ───────── Modèles standard Auth.js (adaptateur Prisma) ─────────

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ───────── Catalogue (phase 2) ─────────
// Importé depuis TCGdex par `npm run sync:catalog`, jamais appelé à chaque requête joueur.

enum Tier {
  common
  uncommon
  rare
  epic
  legendary
  mythic
}

enum Lang {
  fr
  en
}

enum CardCategory {
  pokemon
  trainer
  energy
}

model Serie {
  id               String    @id
  name             String
  logo             String?
  lang             Lang      @default(fr)
  /// Date de sortie du premier set, pour ordonner les séries.
  firstReleaseDate DateTime?
  syncedAt         DateTime  @default(now())
  sets             Set[]
}

model Set {
  id                String          @id
  serieId           String
  serie             Serie           @relation(fields: [serieId], references: [id])
  name              String
  nameEn            String?
  logo              String?
  symbol            String?
  releaseDate       DateTime?
  cardCountOfficial Int
  cardCountTotal    Int
  lang              Lang            @default(fr)
  syncedAt          DateTime        @default(now())
  cards             Card[]
  completions       SetCompletion[]

  @@index([serieId, releaseDate])
  @@index([releaseDate])
}

model Card {
  id             String       @id
  localId        String
  /// Ordre naturel dans le set (numéro de carte quand il est numérique).
  sortKey        Int          @default(0)
  setId          String
  set            Set          @relation(fields: [setId], references: [id])
  nameFr         String?
  nameEn         String?
  /// Nom affiché (FR si disponible, sinon EN).
  name           String
  /// Langue des données affichées (badge « EN » quand la version française n'existe pas).
  lang           Lang
  /// URL de base sur le CDN TCGdex (on ajoute /low.webp ou /high.webp), ou images.pokemontcg.io en repli ; null → visuel de remplacement.
  image          String?
  imageLang      Lang?
  category       CardCategory
  rarityRaw      String?
  tier           Tier
  /// "rarity" | "price_bump" | "fallback" (rareté inconnue du tableau de correspondance).
  tierReason     String
  hp             Int?
  /// Codes canoniques : fire, water, grass…
  types          String[]
  typesRaw       String[]
  stage          String?
  evolveFrom     String?
  dexIds         Int[]
  illustrator    String?
  retreat        Int?
  description    String?
  /// Texte d'effet des cartes Dresseur et Énergie.
  effect         String?
  trainerType    String?
  energyType     String?
  regulationMark String?
  /// [{ name, cost[], damage, effect }]
  attacks        Json         @default("[]")
  abilities      Json         @default("[]")
  /// [{ type, value }] avec type canonique.
  weaknesses     Json         @default("[]")
  resistances    Json         @default("[]")
  /// { normal, reverse, holo, firstEdition }
  variants       Json         @default("{}")
  priceEurTrend  Decimal?     @db.Decimal(10, 2)
  priceUpdatedAt DateTime?
  /// Exclure du tirage (carte sans image, etc.).
  droppable      Boolean      @default(true)
  syncedAt       DateTime     @default(now())
  copies         CardCopy[]
  listings       Listing[]
  sales          Sale[]
  favoritedBy    FavoriteCard[]
  wishedBy       WishlistCard[]
  tradeItems     TradeItem[]

  @@index([setId, sortKey])
  @@index([tier, droppable])
  @@index([illustrator])
  @@index([category])
}

/// Historique des synchronisations (reprise sur erreur, journal).
model SyncRun {
  id         String    @id @default(cuid())
  kind       String
  startedAt  DateTime  @default(now())
  /// Battement de cœur : une synchro en cours le met à jour après chaque set.
  updatedAt  DateTime  @updatedAt
  finishedAt DateTime?
  /// { doneSets: string[] } : sets entièrement traités, sautés à la reprise.
  cursor     Json?
  stats      Json?
  error      String?

  @@index([kind, startedAt])
}

// ───────── Collection (phase 3) ─────────

enum Finish {
  normal
  reverse
  holo
  firstEdition
}

enum CopyStatus {
  owned
  listed
}

/// Un exemplaire possédé = une ligne. Un exemplaire listé au marché change de statut.
model CardCopy {
  id          String     @id @default(cuid())
  ownerId     String
  owner       User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  cardId      String
  card        Card       @relation(fields: [cardId], references: [id])
  finish      Finish     @default(normal)
  status      CopyStatus @default(owned)
  /// booster | set_booster | market | trade | seed
  obtainedVia String
  openingId   String?
  obtainedAt  DateTime   @default(now())
  listings    Listing[]
  tradeItems  TradeItem[]

  @@index([ownerId, cardId])
  @@index([ownerId, obtainedAt])
  @@index([cardId])
}

/// Audit de chaque ouverture : le tirage est figé côté serveur avant toute animation.
model BoosterOpening {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// all_eras | set
  kind      String
  setId     String?
  cardIds   String[]
  tiers     Tier[]
  finishes  Finish[]
  cost      Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ───────── Économie [P4] ─────────

enum LedgerReason {
  seed
  admin
  recycle
  set_booster
  set_bonus
  quest
  /// Historique uniquement : les duels ont été retirés du jeu.
  duel_win
  duel_draw
  duel_loss
  market_fee
  market_sale
  market_purchase
  bid_hold
  bid_release
  guild_create
}

/// Source de vérité des Jetons, en ajout seul. Chaque modification de `User.balance` écrit une ligne
/// dans la même transaction : SUM(delta) = balance (vérifié par `npm run audit:ledger`).
model LedgerEntry {
  id           BigInt       @id @default(autoincrement())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta        Int
  balanceAfter Int
  reason       LedgerReason
  /// Objet lié : "set", "quest", "opening", "listing"…
  refType      String?
  refId        String?
  /// Détails affichés dans l'historique (nombre de cartes recyclées par tier…).
  meta         Json?
  createdAt    DateTime     @default(now())

  @@index([userId, createdAt])
}

/// Set complété par un joueur : le bonus n'est versé qu'une fois, même si des cartes sont recyclées ensuite.
model SetCompletion {
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  setId       String
  set         Set      @relation(fields: [setId], references: [id])
  bonus       Int
  completedAt DateTime @default(now())

  @@id([userId, setId])
}

/// Quêtes du jour, créées à la première visite de la journée (fuseau de `config.quests.timeZone`).
model DailyQuest {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  day       DateTime  @db.Date
  kind      String
  target    Int
  reward    Int
  progress  Int       @default(0)
  claimedAt DateTime?

  @@unique([userId, day, kind])
}

// ───────── Marché [P5] ─────────

enum ListingType {
  fixed
  auction
}

enum ListingStatus {
  active
  sold
  expired
  cancelled
}

/// Annonce d'un exemplaire. Un exemplaire n'a qu'une annonce active à la fois (index unique partiel, voir migration).
model Listing {
  id              String        @id @default(cuid())
  sellerId        String
  seller          User          @relation("seller", fields: [sellerId], references: [id], onDelete: Cascade)
  /// Null si l'exemplaire a été recyclé depuis (l'historique de vente reste).
  copyId          String?
  copy            CardCopy?     @relation(fields: [copyId], references: [id], onDelete: SetNull)
  /// Dénormalisés pour la recherche et l'historique (l'exemplaire change de propriétaire à la vente).
  cardId          String
  card            Card          @relation(fields: [cardId], references: [id])
  finish          Finish
  type            ListingType
  /// Prix fixe, ou prix de départ d'une enchère.
  price           Int
  currentBid      Int?
  currentBidderId String?
  bidCount        Int           @default(0)
  endsAt          DateTime?
  status          ListingStatus @default(active)
  fee             Int
  createdAt       DateTime      @default(now())
  closedAt        DateTime?
  bids            Bid[]
  sale            Sale?

  @@index([status, endsAt])
  @@index([cardId, status])
  @@index([sellerId, status])
  @@index([status, createdAt])
}

model Bid {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  bidderId  String
  bidder    User     @relation(fields: [bidderId], references: [id], onDelete: Cascade)
  amount    Int
  createdAt DateTime @default(now())

  @@index([listingId, amount])
  @@index([bidderId, createdAt])
}

/// Vente conclue (historique et prix moyen par carte).
model Sale {
  id        String   @id @default(cuid())
  listingId String   @unique
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id])
  finish    Finish
  price     Int
  sellerId  String
  seller    User     @relation("seller", fields: [sellerId], references: [id], onDelete: Cascade)
  buyerId   String
  buyer     User     @relation("buyer", fields: [buyerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([cardId, createdAt])
  @@index([createdAt])
}

// ───────── Social (phase 7) ─────────

enum FriendshipStatus {
  pending
  accepted
}

/// Lien d'amitié orienté : une demande crée (A → B, pending) ; l'acceptation passe la ligne
/// en accepted et crée la ligne miroir (B → A, accepted).
model Friendship {
  userId    String
  user      User             @relation("friendFrom", fields: [userId], references: [id], onDelete: Cascade)
  friendId  String
  friend    User             @relation("friendTo", fields: [friendId], references: [id], onDelete: Cascade)
  status    FriendshipStatus @default(pending)
  createdAt DateTime         @default(now())

  @@id([userId, friendId])
  @@index([friendId, status])
}

/// Un joueur bloqué ne peut plus écrire ni demander en ami celui qui l'a bloqué (et inversement).
model Block {
  userId    String
  user      User     @relation("blocker", fields: [userId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, blockedId])
}

enum ReportStatus {
  open
  reviewed
}

model Report {
  id         String       @id @default(cuid())
  reporterId String
  reporter   User         @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetId   String
  target     User         @relation("reportedUser", fields: [targetId], references: [id], onDelete: Cascade)
  /// spam | insult | cheat | name | other
  reason     String
  details    String?
  /// Message signalé, le cas échéant ("dm:<id>" ou "guild:<id>").
  context    String?
  status     ReportStatus @default(open)
  createdAt  DateTime     @default(now())

  @@index([status, createdAt])
}

enum GuildRole {
  owner
  officer
  member
}

model Guild {
  id          String         @id @default(cuid())
  name        String         @unique
  /// Sigle court affiché à côté des pseudos (2 à 5 caractères).
  tag         String         @unique
  description String?
  ownerId     String
  owner       User           @relation(fields: [ownerId], references: [id])
  createdAt   DateTime       @default(now())
  members     GuildMember[]
  messages    GuildMessage[]
}

model GuildMember {
  guildId  String
  guild    Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  /// Un joueur n'appartient qu'à une guilde à la fois.
  userId   String    @unique
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     GuildRole @default(member)
  joinedAt DateTime  @default(now())

  @@id([guildId, userId])
}

model GuildMessage {
  id        String   @id @default(cuid())
  guildId   String
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([guildId, createdAt])
}

model DirectMessage {
  id          String    @id @default(cuid())
  senderId    String
  sender      User      @relation("dmSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User      @relation("dmRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  body        String
  createdAt   DateTime  @default(now())
  readAt      DateTime?

  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, readAt])
}

// ───────── Favoris et wishlist ─────────

/// Carte favorite d'un joueur (choisie parmi ses cartes) : mise en avant, jamais recyclée par « Recycler les doublons ».
model FavoriteCard {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, cardId])
  @@index([userId, createdAt])
}

/// Carte recherchée par un joueur : alerte quand elle est mise en vente, visible sur son profil public.
model WishlistCard {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, cardId])
  @@index([userId, createdAt])
  @@index([cardId])
}

// ───────── Échanges entre joueurs ─────────

enum TradeStatus {
  pending
  accepted
  declined
  cancelled
  /// Remplacée par une contre-proposition (`counterOf` de la nouvelle offre).
  countered
  expired
  /// Une carte n'était plus disponible au moment d'accepter (vendue, recyclée, mise en vente, échangée…).
  unavailable
}

/// Proposition d'échange carte contre carte. Les exemplaires ne sont pas réservés : tout est revérifié à l'acceptation.
model Trade {
  id          String      @id @default(cuid())
  proposerId  String
  proposer    User        @relation("tradeProposer", fields: [proposerId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User        @relation("tradeRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  status      TradeStatus @default(pending)
  message     String?
  /// Offre à laquelle celle-ci répond (contre-proposition).
  counterOfId String?     @unique
  counterOf   Trade?      @relation("counter", fields: [counterOfId], references: [id], onDelete: SetNull)
  counteredBy Trade?      @relation("counter")
  createdAt   DateTime    @default(now())
  expiresAt   DateTime
  closedAt    DateTime?
  items       TradeItem[]

  @@index([recipientId, status])
  @@index([proposerId, status])
}

/// Exemplaire d'un échange, donné par `fromUserId`. Carte et finition dénormalisées pour l'historique.
model TradeItem {
  id         String    @id @default(cuid())
  tradeId    String
  trade      Trade     @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  fromUserId String
  /// Null si l'exemplaire a été recyclé depuis.
  copyId     String?
  copy       CardCopy? @relation(fields: [copyId], references: [id], onDelete: SetNull)
  cardId     String
  card       Card      @relation(fields: [cardId], references: [id])
  finish     Finish

  @@index([tradeId])
  @@index([copyId])
}

/// Classement figé toutes les heures (les pages lisent le dernier instantané, jamais un calcul en direct).
model LeaderboardSnapshot {
  id      String   @id @default(cuid())
  /// collection | sets | market
  kind    String
  takenAt DateTime @default(now())
  /// [{ userId, name, handle, image, value }] triés, 100 premiers.
  entries Json

  @@index([kind, takenAt])
}
